@div class=max-w-6xl mx-auto px-6 sm:px-8 pt-6 pb-4 flex flex-col lg:flex-row items-start gap-8 lg:gap-12

  @div class=flex-1 flex flex-col items-start pt-2

    @div class=mb-4
      {?logo}

    @div class=text-[#f3eee8] text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight
      {title}

    @div class=text-[#a5a29d] text-base sm:text-lg leading-relaxed mt-5 max-w-xl
      {subtitle}

    @div class=flex flex-wrap gap-4 mt-7
      {?actions}


  @div class=flex-1 flex justify-center lg:justify-end pt-2
    {?media}